# Lawu-2.5-Fine Dashboard — Environment Production (srv-fine)
# Backend Rust Axum (search API + Tantivy Wikipedia-ID)
LAWU_BACKEND_URL=http://127.0.0.1:3001

# Dashboard port (diakses via Nginx reverse proxy nanti)
PORT=3000

# Database SQLite (local, untuk chat history & settings)
DATABASE_URL="file:./dev.db"

# NextAuth (opsional — untuk fitur auth jika diperlukan)
NEXTAUTH_SECRET=lawu-2.5-fine-secret-change-in-production
NEXTAUTH_URL=http://192.168.111.103
